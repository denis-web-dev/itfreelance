generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCER
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  OPEN // открыт, принимает отклики
  IN_PROGRESS // исполнитель выбран, работа идёт
  COMPLETED // завершён
  CANCELLED // отменён заказчиком
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(FREELANCER)
  isActive      Boolean        @default(true)
  consentAt     DateTime // согласие на обработку ПДн (152-ФЗ)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
  orders        Order[]
  refreshTokens RefreshToken[]
  favoriteOrders FavoriteOrder[]
  portfolioItems PortfolioItem[]

  @@map("users")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // общие поля
  fullName  String?
  region    String?
  phone     String?
  sphere    String?
  about     String?  @db.VarChar(500)
  site      String?
  telegram  String?
  vk        String?
  skills    String[] @default([])
  tools     String[] @default([])
  avatarUrl String?

  // исполнитель
  experience String?
  rate       Int?

  // заказчик
  companyName String?
  marketYears Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  ratingAvg   Float? // средний рейтинг, считается из отзывов
  ratingCount Int    @default(0)

  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Order {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title       String      @db.VarChar(150)
  description String      @db.VarChar(5000)
  budget      Int // бюджет в рублях, целое число
  tools       String[]    @default([])
  status      OrderStatus @default(OPEN)
  deadline DateTime?     @db.Date
  stages   OrderStage[]
  favorites FavoriteOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status, createdAt])
  @@map("orders")
}

// Избранные заказы исполнителя (сердечко в карточке)
model FavoriteOrder {
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([userId, orderId])
  @@map("favorite_orders")
}

model OrderStage {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  title    String
  budget   Int

  @@unique([orderId, position])
  @@map("order_stages")
}
// Работы в портфолио исполнителя
model PortfolioItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(100)
  projectUrl String   @db.VarChar(200)
  imageKey   String   @db.VarChar(100) // имя файла в хранилище, а не путь и не URL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("portfolio_items")
}
